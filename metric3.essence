language Essence 1.3

$metric3.essence - SumTD (Summing Time Differences)

given height, width : int
given map : matrix [int(1..height), int(1..width)] of int(0..1)

given agents : sequence of
                record { start_x : int
                       , start_y : int
                       , goal_x : int
                       , goal_y : int
                       }
letting nb_agents be |agents|

given steps : int
given reciprocal_scale : int

find agent_location : matrix [int(1..nb_agents), int(1..steps)] of record {x : int(1..height), y : int(1..width)}

letting MOVE be new type enum {U, R, D, L, W}

find agent_move : matrix [int(1..nb_agents), int(2..steps)] of MOVE


$ agent location at the beginning
such that
[ agent_location[agent_id, 1][x] = agent_info[start_x] /\
  agent_location[agent_id, 1][y] = agent_info[start_y]
| (agent_id, agent_info) <- agents
]

$ agent location at the end
such that
[ agent_location[agent_id, steps][x] = agent_info[goal_x] /\
  agent_location[agent_id, steps][y] = agent_info[goal_y]
| (agent_id, agent_info) <- agents
]


$agent moves
such that
[ ( agent_location[a, s][x] - agent_location[a, s-1][x]
  , agent_location[a, s][y] - agent_location[a, s-1][y]
  , agent_move[a, s]
  ) in {(1, 0, D), (-1, 0, U), (0, 1, R), (0, -1, L), (0, 0, W)}
| s : int(2..steps)
, a : int(1..nb_agents)
]


such that
[ map[agent_location[a, t][x], agent_location[a, t][y]] = 0
| a : int(1..nb_agents)
, t : int(1..steps)
]

such that
[ (agent_location[a, t][x], agent_location[a, t][y])
    != (agent_location[b, t][x], agent_location[b, t][y])
| t : int(1..steps)
, a : int(1..nb_agents)
, b : int(a+1..nb_agents)
]

$no swaps
such that
[ !(agent_location[a, t][x] = agent_location[b, t-1][x] /\
    agent_location[a, t][y] = agent_location[b, t-1][y] /\
    agent_location[b, t][x] = agent_location[a, t-1][x] /\
    agent_location[b, t][y] = agent_location[a, t-1][y])
| t : int(2..steps)
, a : int(1..nb_agents)
, b : int(a+1..nb_agents)
]

$such that
$[ ( agent_location[id, s][x] = info[goal_x] /\
$    agent_location[id, s][y] = info[goal_y] )
$    ->
$  ( agent_location[id, s+1][x] = info[goal_x] /\
$    agent_location[id, s+1][y] = info[goal_y] )
$| (id, info) <- agents
$, s : int(1..steps-1)
$]


find T :
    matrix [int(1..nb_agents), int(1..nb_agents), int(1..steps)]
    of int(0..steps)

such that
[ T[a, a, s] = steps
| a : int(1..nb_agents)
, s : int(1..steps)
]

such that
[ T[a, b, s] =
    min([ [steps, |s - s2| ; int(0..1)]
            [toInt(agent_location[a, s] = agent_location[b, s2])]
        | s2 : int(1..steps)
        ])
| a : int(1..nb_agents)
, b : int(a+1..nb_agents)
, s : int(1..steps)
, a != b
]


find T_recip : int(0..reciprocal_scale * nb_agents * (nb_agents - 1) / 2 * steps)
such that
T_recip =
  sum([ reciprocal_scale / T[a, b, s]
      | a : int(1..nb_agents)
      , b : int(a+1..nb_agents)
      , s : int(1..steps)
      , T[a, b, s] != steps
      ])

minimising T_recip
