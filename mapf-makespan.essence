language Essence 1.3
$Makespan as primary objective

given height, width : int
given map : matrix [int(1..height), int(1..width)] of int(0..1)

$each agent has start and goal positions
given agents : sequence of
                record { start_x : int
                       , start_y : int
                       , goal_x : int
                       , goal_y : int
                       }
letting nb_agents be |agents|

$steps = maximum allowed time horizon
given steps : int

$plan[s,i,j] = which agent is at cell (i, j) at time s
find plan : matrix [int(1..steps), int(1..height), int(1..width)] of int(-1..nb_agents)
$ -1 means @
$ 0 means .
$ >0 means agent with that id is there


$agent_location[a, s] = exact (x, y) position of agent a at time s
find agent_location :
        matrix [int(1..nb_agents), int(1..steps)] of
            record {x : int(1..height), y : int(1..width)}

letting MOVE be new type enum {U,R,D,L,W}

$ with respect to step - 1
find agent_move : matrix [int(1..nb_agents), int(2..steps)] of MOVE

$ channelling: agent a is at plan[s, x, y]
such that
[ plan[s, agent_location[a, s][x], agent_location[a, s][y]] = a
| s : int(1..steps)
, a : int(1..nb_agents)
]


such that
[ plan[s, i, j] = a -> (agent_location[a, s][x] = i /\ agent_location[a, s][y] = j)
| s : int(1..steps)
, i : int(1..height)
, j : int(1..width)
, a : int(1..nb_agents)
]



$Vertex conflict
such that
[(agent_location[a,s][x], agent_location[a,s][y])
    != (agent_location[b,s][x], agent_location[b,s][y])
| s : int(1..steps)
, a : int(1..nb_agents)
, b : int(a+1..nb_agents)
]

$ agents cannot occupy wall cells
such that
[map[agent_location[a,s][x], agent_location[a,s][y]] = 0
| a : int(1..nb_agents)
, s : int(1..steps)
]


$ each agent occurs exactly once at each time step
such that
[1 = sum([1 | i : int(1..height), j : int(1..width), plan[s, i, j] = agent_id])
| s : int(1..steps)
, (agent_id, agent_info) <- agents
]

$ @ cells stay @
such that
[map[i,j]=1 -> plan[s,i,j] = -1
| s : int(1..steps)
, i : int(1..height)
, j : int(1..width)
]

$ maintain number of empty cells
letting nb_empty_cells be
    sum([ toInt(map[i,j] = 0)
        | i : int(1..height)
        , j : int(1..width)
        ]) - nb_agents
such that
[nb_empty_cells = sum([1 | i : int(1..height) , j : int(1..width), plan[s, i, j] = 0])
| s : int(1..steps)
]

$ agent location at the beginning
such that
[agent_location[agent_id, 1][x] = agent_info[start_x]  /\
  agent_location[agent_id, 1][y] = agent_info[start_y]
| (agent_id, agent_info) <- agents
]

$ agent location at the end
such that
[agent_location[agent_id, steps][x] = agent_info[goal_x]  /\
  agent_location[agent_id, steps][y] = agent_info[goal_y]
| (agent_id, agent_info) <- agents
]

$ agent moves
such that
[ ( agent_location[a, s][x] - agent_location[a, s-1][x]
  , agent_location[a, s][y] - agent_location[a, s-1][y]
  , agent_move[a, s]
  ) in {(1,0,D),(-1,0,U),(0,1,R),(0,-1,L),(0,0,W)}
| s : int(2..steps)
, a : int(1..nb_agents)
]

$ no swaps: agents a and b cannot exchange positions between s-1 and s
such that
[ !(
    agent_location[a, s][x] = agent_location[b, s-1][x] /\
    agent_location[a, s][y] = agent_location[b, s-1][y] /\
    agent_location[b, s][x] = agent_location[a, s-1][x] /\
    agent_location[b, s][y] = agent_location[a, s-1][y]
  )
| s : int(2..steps)
, a : int(1..nb_agents)
, b : int(a+1..nb_agents)
]

find T : matrix [int(1..nb_agents), int(1..nb_agents), int(1..steps)] of int(0..steps)
such that
[ T[a,b,s] = b_was_ever_at_same_loc_as_a
| a : int(1..nb_agents)
, b : int(1..nb_agents)
, s : int(1..steps)
, a != b
, letting a_loc be agent_location[a, s]
, letting b_was_ever_at_same_loc_as_a be
  min([
        [ steps
        , |s-s2|
        ; int(0..1)
        ][toInt(a_loc = agent_location[b, s2])]
      | s2 : int(1..steps)
      ])
]
